# Prepared runtime image only. No application source, production env, database
# or storage enters this image. Supply the reviewed digest and package pins.
ARG NODE_BASE_IMAGE
FROM ${NODE_BASE_IMAGE}
ARG NODE_BASE_IMAGE
ARG DEBIAN_SNAPSHOT
ARG CHROMIUM_VERSION
ARG DEJAVU_VERSION
ARG LIBERATION_VERSION
ARG NOTO_VERSION

USER root
RUN set -eu; \
    case "$NODE_BASE_IMAGE" in node:22.23.4-bookworm-slim@sha256:*) ;; *) exit 1 ;; esac; \
    test "$(node --version)" = "v22.23.4"; \
    test -n "$DEBIAN_SNAPSHOT"; test -n "$CHROMIUM_VERSION"; \
    test -n "$DEJAVU_VERSION"; test -n "$LIBERATION_VERSION"; test -n "$NOTO_VERSION"; \
    printf '%s\n' "$DEBIAN_SNAPSHOT" | grep -Eq '^[0-9]{8}T[0-9]{6}Z$'; \
    rm -f /etc/apt/sources.list.d/debian.sources; \
    printf '%s\n' \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/ bookworm main" \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}/ bookworm-security main" \
      > /etc/apt/sources.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      "chromium=${CHROMIUM_VERSION}" "chromium-common=${CHROMIUM_VERSION}" "chromium-sandbox=${CHROMIUM_VERSION}" \
      "fonts-dejavu-core=${DEJAVU_VERSION}" "fonts-liberation=${LIBERATION_VERSION}" "fonts-noto-core=${NOTO_VERSION}"; \
    dpkg-query -W -f='${Package}=${Version}\n' | sort > /usr/local/share/apply-contract-runtime-packages.txt; \
    chromium --version; \
    rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
WORKDIR /opt/findandstudy/releases/20260911T101300Z-a5f31e065682
USER 10000:10000
ENTRYPOINT ["node"]
CMD ["/opt/findandstudy/releases/20260911T101300Z-a5f31e065682/artifacts/api-server/dist/index.cjs"]
